{
  "name": "@workspace/medicare-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "pnpm run test:unit && vite build --config vite.config.ts && vite build --config vite.ssr.config.ts && node prerender.mjs && node scripts/validate-prerender.mjs && node scripts/validate-inner-prerender.mjs && node scripts/validate-seo-output.mjs && node scripts/validate-canonical-server.mjs",
    "build:ci": "PORT=25970 BASE_PATH=/ vite build --config vite.config.ts && PORT=25970 BASE_PATH=/ vite build --config vite.ssr.config.ts && node prerender.mjs && node scripts/validate-prerender.mjs && node scripts/validate-inner-prerender.mjs && node scripts/validate-seo-output.mjs && node scripts/validate-canonical-server.mjs && pnpm run verify-prerender",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "start": "node artifacts/medicare-site/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "pnpm run check:unit-hygiene && vitest run",
    "test": "pnpm run test:unit && pnpm run check:e2e-hygiene && pnpm run test:pre-commit-hygiene",
    "test:pre-commit-hygiene": "node --test scripts/check-pre-commit-hygiene.test.mjs",
    "check:unit-hygiene": "node scripts/check-unit-test-hygiene.mjs",
    "test:unit-hygiene": "node --test scripts/check-unit-test-hygiene.test.mjs",
    "check:e2e-hygiene": "node --test e2e/check-viewport-guards.test.mjs",
    "verify-prerender": "node scripts/verify-prerender.mjs",
    "check:viewport-guards": "node e2e/check-viewport-guards.mjs",
    "test:e2e": "node e2e/check-viewport-guards.mjs && playwright test",
    "indexnow": "node scripts/indexnow.mjs",
    "indexnow:all": "node scripts/indexnow.mjs --all"
  },
